{
  "name": "@yuzuwoeser/astr3",
  "version": "0.1.1",
  "description": "ASTR3: explorable astrology wheels for the browser, built with Three.js.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "chart-template.schema.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.js"
    },
    "./ephemeris": {
      "types": "./dist/ephemeris/index.d.ts",
      "import": "./dist/ephemeris/index.js"
    },
    "./chart-template.schema.json": "./chart-template.schema.json"
  },
  "scripts": {
    "dev": "npm run build:site && vite --config site/vite.config.ts",
    "build": "node scripts/build.mjs",
    "build:demo": "npm run build:site --",
    "build:pages": "npm run build:site -- --base /astr3/",
    "preview:pages": "vite preview --config site/vite.config.ts --base /astr3/ --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:pages": "npm run build:pages && playwright test --config playwright.pages.config.ts",
    "test:package": "node scripts/check-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "capture:marketing": "node scripts/capture-marketing.mjs",
    "check": "npm run typecheck && npm test && npm run build:site && npm run typecheck:examples && npm run test:recipes && npm run test:package",
    "prepack": "npm run build",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "typecheck:examples": "npm run typecheck --workspaces --if-present",
    "test:recipes": "node scripts/check-recipes.mjs",
    "build:release": "npm run build && node scripts/build-release.mjs",
    "test:release": "playwright test --config playwright.release.config.ts",
    "test:wordpress": "node scripts/test-wordpress.mjs",
    "test:starters": "node scripts/check-starters.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "astronomy-engine": "^2.1.19",
    "three": "^0.186.0"
  },
  "peerDependenciesMeta": {
    "astronomy-engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@wp-playground/cli": "3.1.60",
    "ajv": "^8.20.0",
    "astronomy-engine": "^2.1.19",
    "highlight.js": "11.12.0",
    "marked": "18.1.1",
    "opentype.js": "1.3.4",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "author": "yuzuwoeser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuzuwoeser/astr3.git"
  },
  "homepage": "https://yuzuwoeser.github.io/astr3/",
  "bugs": {
    "url": "https://github.com/yuzuwoeser/astr3/issues"
  },
  "keywords": [
    "astrology",
    "threejs",
    "natal-chart",
    "transits",
    "typescript",
    "interactive"
  ],
  "workspaces": [
    "examples/javascript",
    "examples/typescript",
    "examples/json-templates",
    "examples/react",
    "examples/vue",
    "examples/svelte",
    "examples/angular",
    "examples/rails"
  ],
  "publishConfig": {
    "access": "public"
  }
}
