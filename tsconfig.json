{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@yuzuwoeser/astr3": ["./src/index.ts"],
      "@yuzuwoeser/astr3/model": ["./src/model/index.ts"],
      "@yuzuwoeser/astr3/ephemeris": ["./src/ephemeris/index.ts"]
    }
  },
  "include": ["src", "site", "examples/playground", "tests", "*.config.ts"]
}
