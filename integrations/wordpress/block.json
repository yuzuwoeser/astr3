{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "astr3/chart",
  "version": "__VERSION__",
  "title": "ASTR3 Chart",
  "category": "widgets",
  "icon": "chart-pie",
  "description": "Display an interactive natal or transit chart from JSON data.",
  "textdomain": "astr3",
  "attributes": {
    "chartId": { "type": "string", "default": "" },
    "kind": { "type": "string", "default": "natal" },
    "dataJson": { "type": "string", "default": "" },
    "preset": { "type": "string", "default": "midnight" },
    "label": { "type": "string", "default": "Astrology chart" }
  },
  "supports": { "html": false },
  "editorScript": "astr3-editor",
  "editorStyle": "astr3-chart"
}
